<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/bg_primary"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/song_album"
            android:layout_width="112dp"
            android:layout_height="112dp"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/text_primary"
                android:id="@+id/slider_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <TextView
                android:textColor="?attr/text_secondary"
                android:id="@+id/slider_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_below="@+id/slider_title"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/listen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mab_play"
                android:layout_alignParentBottom="true"
                android:insetTop="8dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:icon="@drawable/player_play"
                style="@style/MusicWhiteActionBtn"/>
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
