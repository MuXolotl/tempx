<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root"
    android:background="@drawable/ripple_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingStart="16dp">
    <FrameLayout
        android:id="@+id/inner_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/song_album"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/song_overlay"
            android:background="@drawable/playing_overlay"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <ImageView
            android:id="@+id/song_selected"
            android:background="@drawable/playing_overlay"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/song_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/text_primary"
            android:gravity="center_vertical"
            android:id="@+id/song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="2dp"
            app:drawableTint="?attr/text_secondary"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/text_secondary"
            android:ellipsize="end"
            android:id="@+id/song_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/anchor"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp">
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/song_duration"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:includeFontPadding="false"
            style="@style/TextStyle.ListItem.Snippet"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/download_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_download_outline_28"
            android:contentDescription="@null"
            app:tint="?android:attr/textColorPrimary"/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:id="@+id/call_menu"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_more"
        android:contentDescription="@string/track_menu"
        android:layout_marginStart="10dp"
        android:paddingHorizontal="12dp"
        app:tint="?android:attr/textColorPrimary"/>
</LinearLayout>
