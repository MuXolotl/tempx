<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/card"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/bg_primary"
    app:cardCornerRadius="8dp"
    app:strokeColor="?attr/scrim_color_lighter"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/header"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="140dp">
            <ImageView
                android:id="@+id/playlist_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:background="#60000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/percent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:fontFamily="@font/vk_sans_display_demibold"
                    style="@style/TextStyle.ListItem"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/percent_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:alpha="0.7"
                    android:fontFamily="@font/vk_sans_display_regular"
                    style="@style/TextStyle.ListItem"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/play"
                android:layout_alignBottom="@+id/play"
                android:layout_marginStart="16dp"
                android:layout_toStartOf="@+id/play"
                android:layout_toEndOf="@+id/play"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/common"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@font/vk_sans_display_demibold"
                    style="@style/TextStyle.ListItem"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/avatar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/user"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="@font/vk_sans_display_demibold"
                        android:layout_marginStart="8dp"
                        style="@style/TextStyle.ListItem"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/play"
                android:background="@drawable/circle"
                android:padding="10dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:src="@drawable/player_play"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/google_white"
                app:tint="@color/google_black"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/audios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
