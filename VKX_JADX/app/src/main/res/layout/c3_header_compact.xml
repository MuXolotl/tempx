<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@{title}"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/post_side_padding"
        android:layout_marginEnd="8dp"
        style="@style/TextStyle"/>
    <ImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_dismiss_24"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="16dp"
        app:tint="?attr/text_primary"/>
    <TextView
        android:textColor="?attr/colorAccent"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/show_all_btn"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_all"
        android:backgroundTint="?attr/global_accent"
        style="@style/TextButton.Blue"/>
</FrameLayout>
