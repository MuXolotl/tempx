<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/scrim_color">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#ffffffff"/>
            <corners android:radius="@dimen/vkx_corner_radius"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#33999999"/>
                    <corners android:radius="@dimen/vkx_corner_radius"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#00000000"/>
                    <corners android:radius="@dimen/vkx_corner_radius"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
